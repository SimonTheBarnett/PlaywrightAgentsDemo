{
  "name": "playwright-agents-demo",
  "version": "0.1.0",
  "description": "PlaywrightAgentsDemo: local Wee B&B application and Playwright Test Agent demonstration.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx app/server/index.ts",
    "dev:client": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "data:reset": "tsx scripts/reset.ts",
    "test": "playwright test --project=chromium",
    "test:e2e": "playwright test --project=chromium",
    "agent:seed": "playwright test --project=agent-seed --reporter=list",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
